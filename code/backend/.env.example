# Copy this file to .env and fill in real values. Never commit .env itself.

# Directory containing the trained models, feature columns, SHAP values,
# and evaluation artefacts. See model_artifacts/ARTIFACTS.md for details.
ARTIFACT_DIR=model_artifacts

# Secret used to sign JWTs. Generate a random 32+ byte string for real use,
# e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# MongoDB connection (stores user accounts only — forecast data lives in
# model_artifacts/ and is loaded into memory at startup).
MONGO_URI=mongodb://localhost:27017
MONGO_DB=rossmann_dss

# Required for the AI Agent page (POST /agent/recommend).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — used by scripts/seed_admin.py. Defaults to admin / admin123
# if unset; change the password after first login either way.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
